   "source": [
    "import torch\n",
    "\n",
    "logits = torch.tensor([2.0, 1.0, 0.1])\n",
    "\n",
    "probabilities = torch.softmax(logits, dim=0)\n",
    "\n",
    "print(\"Logits:\")\n",
    "print(logits)\n",
    "\n",
    "print(\"\\nProbabilities:\")\n",
    "print(probabilities)\n",
    "\n",
    "print(\"\\nSum:\")\n",
    "print(probabilities.sum())"
   ]
  }
